<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="350" prefWidth="400" spacing="15"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.megateam.lab.ui.AuthController">

    <padding>
        <Insets bottom="20" left="30" right="30" top="20" />
    </padding>


    <Label text="Incident Management System"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <Label fx:id="statusLabel" text="Please login or register"
           style="-fx-font-size: 14px"/>


    <GridPane hgap="10" vgap="10" alignment="CENTER">
        <padding>
            <Insets bottom="10" left="10" right="10" top="10" />
        </padding>

        <Label text="Login:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="loginField" GridPane.rowIndex="0" GridPane.columnIndex="1"
                   promptText="Enter login"/>

        <Label text="Password:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <PasswordField fx:id="passwordField" GridPane.rowIndex="1" GridPane.columnIndex="1"
                       promptText="Enter password"/>
    </GridPane>


    <HBox alignment="CENTER" spacing="10">
        <Button fx:id="loginButton" text="Login"
                style="-fx-background-color: white; -fx-font-weight: bold;"/>
        <Button fx:id="registerButton" text="Register"
                style="-fx-background-color: white; "/>
    </HBox>

    <Label fx:id="errorLabel" text=""
           style="-fx-font-size: 12px;"
           wrapText="true" maxWidth="340"/>

</VBox>